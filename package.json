{
  "name": "myapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "start": "npm run build && node backend/server.js",
    "dev": "node scripts/dev.js",
    "dev:frontend": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "dev:backend": "node backend/server.js",
    "build": "node scripts/build-catalog.mjs && vite build",
    "build:vercel": "node scripts/build-catalog.mjs && vite build --mode vercel",
    "test": "vitest --run && node --test backend/tests/api.test.js backend/tests/static-cache.test.js",
    "test:python": "python -m unittest discover -s python-projects/tests -p \"test_*.py\"",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.15.1 autorun",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "catalog:build": "node scripts/build-catalog.mjs",
    "predev": "node scripts/build-catalog.mjs",
    "build:frontend": "vite build",
    "prestart": "node scripts/build-catalog.mjs",
    "bootstrap:shim": "node scripts/filter-bootstrap-css.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
