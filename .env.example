# Local configuration for the development server. Copy to .env (gitignored) and adjust.
# Nothing here is required: every value has the default the README describes.
# The Vercel deployment is a static bundle and reads none of these — it makes no API calls.

# Ports used by `npm run dev` (API) and the Vite dev server that proxies /api to it.
API_PORT=3001
FRONTEND_PORT=3000

# Bind address and port for `node backend/server.js`. Keep HOST on loopback: as soon as it is any
# other interface the API stops accepting settings writes from the browser page, because a secret
# the page could carry is not a secret. Set it only when you mean to let other machines reach the app.
HOST=127.0.0.1
PORT=3001

# Shared secret that unlocks settings writes for scripted clients, sent as
# `Authorization: Bearer <token>`. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The website never sends it, so configuring it does not re-enable browser writes — that is intended.
# Keep it out of this file in any copy that leaves your machine — .env is gitignored for that reason.
API_WRITE_TOKEN=

# Where the SQLite file lives. Unset means static-web-development.db next to backend/server.js, and
# the file is ignored by git and never part of a deployment; set it only to keep the data elsewhere.
DATABASE_PATH=
